FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/expense-advisor
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini
FOUNDRY_ADVISOR_DEPLOYMENT=gpt-4o
AZURE_SEARCH_ENDPOINT=https://<search-name>.search.windows.net
AZURE_SEARCH_INDEX=expenses
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EXPENSES_PATH=app/ai/labs/lab03_seed_expenses.json

# Optional failover deployments per task (comma-separated deployment names; empty = none)
FOUNDRY_FALLBACK_CATEGORIZE=
FOUNDRY_FALLBACK_ADVISE=

# Lab 8: name of the content-filter policy attached to the advisor deployment (recorded in audit.jsonl)
CONTENT_POLICY_NAME=expense-advisor-policy

# Lab 8: pinned model version of the advisor deployment (recorded in audit.jsonl; keep in sync with infra)
ADVISOR_MODEL_VERSION=2024-11-20
